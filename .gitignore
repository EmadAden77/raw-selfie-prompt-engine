# ==========================================
# Raw Selfie Prompt Engine
# Git Ignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Build output
dist/
**/dist/
build/
**/build/
out/
**/out/
coverage/
**/coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Vite
.vite/
**/.vite/
vite.svg

# Package manager cache
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test output
test-results/
playwright-report/
blob-report/

# Runtime files
*.pid
*.pid.lock
*.seed
pids/

# Temporary files
tmp/
temp/
.cache/
**/.cache/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Editor configuration
.vscode/
.idea/
*.iml

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/

# Local reference images and uploads
uploads/
**/uploads/
reference-images/
**/reference-images/

# Local user-generated image files
*.local.png
*.local.jpg
*.local.jpeg
*.local.webp
*.local.heic

# Local secrets
secrets/
**/secrets/

# Local deployment output
.vercel/
.netlify/

# Keep source code, documentation,
# package manifests and lockfiles tracked.
